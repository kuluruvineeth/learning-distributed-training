      "customData": {
        "section": "10-yardstick",
        "anchor": [
          1700,
          10185,
          "lt"
        ]
      },
      "text": "ZeRO-3 gathers every whole layer, twice a step, on every GPU\nZeRO splits state, not activations; tp splits them inside each layer\ndp 64 means a global batch of at least 64 sequences\npp 4 with 8 micro-batches still idles 27% of each step\ntp stops at 8: key/value heads, and one node",
      "originalText": "ZeRO-3 gathers every whole layer, twice a step, on every GPU\nZeRO splits state, not activations; tp splits them inside each layer\ndp 64 means a global batch of at least 64 sequences\npp 4 with 8 micro-batches still idles 27% of each step\ntp stops at 8: key/value heads, and one node",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAB"
