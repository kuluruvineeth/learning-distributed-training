      "customData": {
        "section": "5-heads",
        "anchor": [
          0,
          5490,
          "lt"
        ]
      },
      "text": "Llama 3 8B: 32 query heads share 8 key/value heads, 4 queries per kv head",
      "originalText": "Llama 3 8B: 32 query heads share 8 key/value heads, 4 queries per kv head",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b5E"
    },
    {
      "id": "5-heads-387",
      "type": "text",
      "x": 0,
      "y": 5550,
      "width": 1248,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#141414",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2950828484,
      "version": 2,
      "versionNonce": 2129492116,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792906735647,
      "link": null,
      "locked": false,
      "customData": {
        "section": "5-heads",
        "anchor": [
          0,
          5550,
          "lt"
        ]
      },
      "text": "q_proj cut by columns = whole heads to each GPU; a head never needs another head",
      "originalText": "q_proj cut by columns = whole heads to each GPU; a head never needs another head",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b5F"
    },
    {
      "id": "5-heads-388",
      "type": "text",
      "x": 0,
      "y": 5630,
      "width": 884,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#141414",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 265783124,
      "version": 2,
      "versionNonce": 1261636268,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792906735647,
      "link": null,
      "locked": false,
      "customData": {
        "section": "5-heads",
        "anchor": [
          0,
          5630,
          "lt"
        ]
      },
      "text": "32 / 8 = 4 query heads,  8 / 8 = 1 kv head per GPU",
      "originalText": "32 / 8 = 4 query heads,  8 / 8 = 1 kv head per GPU",
      "fontSize": 34,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b5G"
    },
    {
      "id": "5-heads-389",
      "type": "text",
      "x": 0,
      "y": 5710,
      "width": 673.9200000000001,
      "height": 60,
      "angle": 0,
      "strokeColor": "#141414",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2265757008,
      "version": 2,
