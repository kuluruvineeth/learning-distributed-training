      "isDeleted": false,
      "boundElements": [],
      "updated": 1792906735647,
      "link": null,
      "locked": false,
      "customData": {
        "section": "5-heads",
        "anchor": [
          0,
          5710,
          "lt"
        ]
      },
      "text": "8 kv heads → 8 GPUs at most",
      "originalText": "8 kv heads → 8 GPUs at most",
      "fontSize": 48,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b5H"
    },
    {
      "id": "5-heads-390",
      "type": "text",
