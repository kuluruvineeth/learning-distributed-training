      "customData": {
        "section": "5-heads",
        "anchor": [
          0,
          5800,
          "lt"
        ]
      },
      "text": "past 8, a kv head would be copied onto several GPUs (vLLM does, for inference);\nin training the copies' gradients would need adding too, so our code refuses",
      "originalText": "past 8, a kv head would be copied onto several GPUs (vLLM does, for inference);\nin training the copies' gradients would need adding too, so our code refuses",
