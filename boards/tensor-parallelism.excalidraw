      "y": 5800,
      "width": 1150.24,
      "height": 70,
      "angle": 0,
      "strokeColor": "#5F5F5F",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
